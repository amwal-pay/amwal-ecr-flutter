<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The terminal is reached over the local network, so the host app needs
      INTERNET. Declared here so an integrator cannot forget it and then debug
      a "terminal unreachable" that is really a missing permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
